FROM python:3.12-slim

ENV PYTHONUNBUFFERED True

# set the working directory
WORKDIR /usr/src/app

# install dependencies
COPY ./requirements.txt ./

RUN pip install --no-cache-dir -r requirements.txt

# Set PYTHONPATH to include the application directory
ENV PYTHONPATH=/usr/src/app/application

# copy application code
COPY ./application ./application

EXPOSE 4005

# start the server
ENTRYPOINT ["streamlit", "run", "application/modelo_ml_streamlit.py", "--server.port=4005", "--server.address=0.0.0.0"]

# start the server
#CMD ["uvicorn", "application.main:app", "--host", "0.0.0.0", "--port", "4005", "--proxy-headers"]